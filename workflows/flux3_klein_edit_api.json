{
  "unet": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Klein model"},
    "inputs": {"unet_name": "flux3-image-klein-int8-convrot.safetensors", "weight_dtype": "default"}
  },
  "clip": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Klein text encoder"},
    "inputs": {"clip_name": "qwen3vl_4b_int8_convrot.safetensors", "type": "flux3"}
  },
  "vae": {
    "class_type": "VAELoader",
    "_meta": {"title": "Klein VAE"},
    "inputs": {"vae_name": "flux2-vae.safetensors"}
  },
  "sampling": {
    "class_type": "ModelSamplingFlux",
    "_meta": {"title": "shift"},
    "inputs": {"model": ["unet", 0], "max_shift": 2.7726, "base_shift": 2.7726, "width": 1024, "height": 1024}
  },
  "prompt": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "prompt"},
    "inputs": {"text": "", "clip": ["clip", 0]}
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "negative"},
    "inputs": {"text": "", "clip": ["clip", 0]}
  },
  "reference": {
    "class_type": "LoadImage",
    "_meta": {"title": "source image"},
    "inputs": {"image": "source.png"}
  },
  "scale_ref": {
    "class_type": "ImageScale",
    "_meta": {"title": "scale source"},
    "inputs": {"image": ["reference", 0], "upscale_method": "lanczos", "width": 0, "height": 768, "crop": "disabled"}
  },
  "encode_ref": {
    "class_type": "VAEEncode",
    "_meta": {"title": "encode source"},
    "inputs": {"pixels": ["scale_ref", 0], "vae": ["vae", 0]}
  },
  "ref_pos": {
    "class_type": "ReferenceLatent",
    "_meta": {"title": "reference on prompt"},
    "inputs": {"conditioning": ["prompt", 0], "latent": ["encode_ref", 0]}
  },
  "ref_neg": {
    "class_type": "ReferenceLatent",
    "_meta": {"title": "reference on negative"},
    "inputs": {"conditioning": ["negative", 0], "latent": ["encode_ref", 0]}
  },
  "latent": {
    "class_type": "EmptyFlux2LatentImage",
    "_meta": {"title": "canvas"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": {"title": "sampler"},
    "inputs": {
      "seed": 0, "steps": 16, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
      "model": ["sampling", 0], "positive": ["ref_pos", 0], "negative": ["ref_neg", 0], "latent_image": ["latent", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": {"title": "decode"},
    "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}
  },
  "save": {
    "class_type": "SaveImage",
    "_meta": {"title": "save"},
    "inputs": {"images": ["decode", 0], "filename_prefix": "apc40/klein"}
  }
}
